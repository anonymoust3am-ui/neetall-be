generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(uuid()) @map("_id")
  firebaseUid     String  @unique @map("firebase_uid")
  phone           String  @unique
  phoneVerified   Boolean @default(true) @map("phone_verified")
  email           String?
  emailVerified   Boolean @default(false) @map("email_verified")
  isEmailCodeSent Boolean @default(false) @map("is_email_code_sent")

  // Email login fields
  enableEmailLogin   Boolean   @default(false) @map("enable_email_login")
  emailLoginVerified Boolean   @default(false) @map("email_login_verified")
  passwordHash       String?   @map("password_hash")
  lastEmailLoginAt   DateTime? @map("last_email_login_at")
  emailLoginAttempts Int       @default(0) @map("email_login_attempts")

  name                   String?
  updatedAt              DateTime                @updatedAt
  alternatePhone         String?
  country                String?                 @default("IN")
  state                  String?
  city                   String?
  dob                    String?
  PrefExam               String?
  profilePic             String?
  Role                   String?                 @default("student")
  RefSource              String?                 @default("google")
  Rank                   Int?                    @default(0)
  Score                  Int?                    @default(0)
  Category               String?                 @default("general")
  Gender                 String?                 @default("N/A")
  isProfileComplete      Boolean                 @default(false)
  refralCode             String?                 @unique
  Theme                  String?                 @default("light")
  isAiEnabled            Boolean                 @default(false) @map("is_ai_enabled")
  isAiCreditSystem       Boolean                 @default(true) @map("is_ai_credit_system")
  aiCredits              Int                     @default(10) @map("ai_credits")
  aiCreditLimit          Int?                    @default(50) @map("ai_credit_limit")
  aiUserSummurry         String?                 @map("ai_user_summurry")
  refredUsers            RefredUser[]
  aiChatHistory          AiChatHistory[]
  Sessions               Session[]
  emailVerificationCodes EmailVerificationCode[]
  userPackages           UserPackage[]
  payments               Payment[]
  Testimonial            Testimonial?
  ChoiceList             ChoiceList[]
  PredictionQuery        PredictionQuery[]
  fcmTokens              FcmToken[]
  createdAt              DateTime                @default(now())
}

model AiChatHistory {
  id        String       @id @default(uuid()) @map("_id")
  title     String
  messages  AiMessages[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
}

model AiMessages {
  id        String   @id @default(uuid()) @map("_id")
  role      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiChatHistory   AiChatHistory @relation(fields: [aiChatHistoryId], references: [id], onDelete: Cascade)
  aiChatHistoryId String        @map("ai_chat_history_id")
}

model ChoiceList {
  id          String @id @default(uuid()) @map("_id")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String @map("user_id")
  name        String @unique
  Caunselling String

  ChoiceListDetails ChoiceListDetails[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ChoiceListDetails {
  id           String     @id @default(uuid()) @map("_id")
  choiceList   ChoiceList @relation(fields: [choiceListId], references: [id], onDelete: Cascade)
  choiceListId String     @map("choice_list_id")
  name         String     @unique
  Caunselling  String
  Institute    String
  Course       String
  Quota        String
  Catagory     String
  InsertAt     Int?
  closingRanks Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model RefredUser {
  id             String   @id @default(uuid()) @map("_id")
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @map("user_id") // the referrer
  referredUserId String   @map("referred_user_id") // the person who was referred
  referredName   String?  @map("referred_name")
  referredPhone  String?  @map("referred_phone")
  isRewarded     Boolean  @default(false) @map("is_rewarded")
  createdAt      DateTime @default(now())
}

model Session {
  id         String    @id @default(uuid()) @map("_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  DeviceId   String?   @unique @map("device_id")
  DeviceType String?   @map("device_type")
  deviceName String?   @map("device_name")
  IpAddress  String?   @map("ip_address")
  LastSeen   DateTime? @map("last_seen")
  IsActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EmailVerificationCode {
  id        String   @id @default(uuid()) @map("_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String             @id @default(uuid()) @map("_id")
  user       User               @relation(fields: [userId], references: [id])
  userId     String             @unique // 🔒 ensures ONE testimonial per user
  title      String?
  content    String? // written review
  rating     Int? // optional (1–5)
  media      TestimonialMedia[]
  isApproved Boolean            @default(false) // moderation
  isFeatured Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model TestimonialMedia {
  id            String      @id @default(uuid()) @map("_id")
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id])
  testimonialId String
  type          MediaType
  url           String
  thumbnailUrl  String? // useful for videos
  createdAt     DateTime    @default(now())
}

enum MediaType {
  VIDEO
  IMAGE
}

model Package {
  id           String       @id @default(uuid()) @map("_id")
  name         String // e.g. "NEET PG 2025"
  tier         Tier // PRO | STANDARD
  price        Int // in INR (₹4499 → 4499)
  currency     String       @default("INR")
  validTill    DateTime
  availability Availability

  coverage   Coverage @relation(fields: [coverageId], references: [id])
  coverageId String

  features   PackageFeature[]
  tools      PackageTool[]
  insights   PackageInsight[]
  explores   PackageExplore[]
  CouponCode String?          @map("coupon_code")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  userPackages UserPackage[]
}

model UserPackage {
  id        String    @id @default(uuid()) @map("_id")
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @map("user_id")
  package   Package   @relation(fields: [packageId], references: [id])
  packageId String    @map("package_id")
  payment   Payment?  @relation(fields: [paymentId], references: [id])
  paymentId String?   @map("payment_id")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now())
}

model Payment {
  id                String        @id @default(uuid()) @map("_id")
  user              User          @relation(fields: [userId], references: [id])
  userId            String        @map("user_id")
  packageId         String        @map("package_id")
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  amount            Int // in paise (₹449900 = ₹4499)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  couponCode        String?       @map("coupon_code")
  discountAmount    Int?          @map("discount_amount") // in paise
  receipt           String        @unique
  userPackages      UserPackage[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Coupon {
  id          String   @id @default(uuid()) @map("_id")
  code        String   @unique
  description String?
  discount    Int // in percentage (20% → 20)
  validTill   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coverage {
  id          String       @id @default(uuid()) @map("_id")
  type        CoverageType // ALL_INDIA | ALL_INDIA_AND_STATES
  description String? // "All India & 40+ State Counsellings"
  packages    Package[]
}

model Feature {
  id       String           @id @default(uuid()) @map("_id")
  name     String
  packages PackageFeature[]
}

model Tool {
  id       String        @id @default(uuid()) @map("_id")
  name     String
  packages PackageTool[]
}

model Insight {
  id       String           @id @default(uuid()) @map("_id")
  name     String
  packages PackageInsight[]
}

model Explore {
  id       String           @id @default(uuid()) @map("_id")
  name     String
  packages PackageExplore[]
}

model PackageFeature {
  id        String  @id @default(uuid()) @map("_id")
  package   Package @relation(fields: [packageId], references: [id])
  packageId String  @map("package_id")
  feature   Feature @relation(fields: [featureId], references: [id])
  featureId String  @map("feature_id")
}

model PackageTool {
  id        String  @id @default(uuid()) @map("_id")
  package   Package @relation(fields: [packageId], references: [id])
  packageId String  @map("package_id")
  tool      Tool    @relation(fields: [toolId], references: [id])
  toolId    String  @map("tool_id")
}

model PackageInsight {
  id        String  @id @default(uuid()) @map("_id")
  package   Package @relation(fields: [packageId], references: [id])
  packageId String  @map("package_id")
  insight   Insight @relation(fields: [insightId], references: [id])
  insightId String  @map("insight_id")
}

model PackageExplore {
  id        String  @id @default(uuid()) @map("_id")
  package   Package @relation(fields: [packageId], references: [id])
  packageId String  @map("package_id")
  explore   Explore @relation(fields: [exploreId], references: [id])
  exploreId String  @map("explore_id")
}

enum Tier {
  PRO
  STANDARD
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum CoverageType {
  ALL_INDIA
  ALL_INDIA_AND_STATES
}

model Blogs {
  id            String   @id @default(uuid()) @map("_id")
  title         String
  description   String?
  content       String?
  author        Author   @relation(fields: [authorId], references: [id])
  authorId      String   @map("author_id")
  slug          String?  @unique
  imageUrl      String?
  coverImageUrl String?
  tags          String[] // e.g. ["NEET", "Exam Tips", "Study Plan"]
  faqs          FAQ[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FAQ {
  id       String @id @default(uuid()) @map("_id")
  question String
  answer   String
  blog     Blogs  @relation(fields: [blogId], references: [id])
  blogId   String @map("blog_id")
}

model Author {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  tag         String?
  bio         String?
  avatarUrl   String?
  expertise   String?
  Blogs       Blogs[]
  socialLinks SocialLink[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SocialLink {
  id       String @id @default(uuid()) @map("_id")
  platform String @default("linkedin") // e.g. "linkedin", "twitter", "facebook", youtube", "instagram"
  url      String
  author   Author @relation(fields: [authorId], references: [id])
  authorId String @map("author_id")
}

model CounsellingOption {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  value String  @unique
  label String
  desc  String?
  icon  String?

  bodies Body[]
}

model Body {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  key  String?
  name String

  counsellingType     String? @map("counselling_type")
  state               String?
  websiteGoto         String? @map("website_goto")
  websiteRegistration String? @map("website_registration")
  websiteProspectus   String? @map("website_prospectus")
  isPinned            Boolean @default(false) @map("is_pinned")

  allotmentSessions      String[] @map("allotment_sessions")
  closingRankSessions    String[] @map("closing_rank_sessions")
  seatMatrixSessions     String[] @map("seat_matrix_sessions")
  feeStipendBondSessions String[] @map("fee_stipend_bond_sessions")

  quotas BodyQuota[]

  optionId String            @db.ObjectId
  option   CounsellingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model BodyQuota {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  shortName          String? @map("short_name")
  tooltipContent     String? @map("tooltip_content")
  tooltipContentHtml String? @map("tooltip_content_html")
  masterQuota        String? @map("master_quota")

  bodyId String @db.ObjectId
  body   Body   @relation(fields: [bodyId], references: [id], onDelete: Cascade)
}

enum CounsellingLevel {
  ALL_INDIA
  STATE
  DEEMED
  CENTRAL
  PRIVATE_MANAGEMENT
  OTHER
}

enum CourseType {
  MBBS
  BDS
  BAMS
  BHMS
  BUMS
  BVSC
  OTHER
}

enum SeatOwnership {
  GOVERNMENT
  PRIVATE
  DEEMED
  AIIMS
  JIPMER
  CENTRAL_UNIVERSITY
  MINORITY
  MANAGEMENT
  NRI
  ESI
  OTHER
}

enum PredictionChance {
  SAFE
  POSSIBLE
  RISKY
  VERY_RISKY
  NOT_MATCHED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model State {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  name String
  code String?
  slug String

  institutes   Institute[]
  counsellings Counselling[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Counselling {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sourceCounsellingId String?
  name                String
  slug                String
  level               CounsellingLevel

  stateId String? @db.ObjectId
  state   State?  @relation(fields: [stateId], references: [id])

  sourceStateName String?
  year            Int?
  isActive        Boolean @default(true)

  quotas     Quota[]
  allotments AllotmentRecord[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categoryMaps CategoryMap[]

  @@index([sourceCounsellingId, year])
  @@index([level])
  @@index([stateId])
  @@index([name])
  @@index([year])
}

model Institute {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sourceInstituteId String?
  name              String
  state             String
  instituteType     String

  beds  Int
  seats Int

  logoUrl  String?
  coverUrl String?

  university UniversityInfo
  fee        FeeRange?

  tabsToDisplay String[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stateRef         State?            @relation(fields: [stateId], references: [id])
  stateId          String?           @db.ObjectId
  allotmentRecords AllotmentRecord[]
}

model University {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  sourceId       String  @unique
  name           String
  universityType String?
  state          String?
  websiteGoto    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type UniversityInfo {
  id   Int
  name String
}

type FeeRange {
  min Float
  max Float
}

model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sourceCourseId String?
  name           String
  shortName      String?
  slug           String
  type           CourseType @default(OTHER)
  isActive       Boolean    @default(true)

  allotments AllotmentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([sourceCourseId])
  @@index([name])
  @@index([type])
}

model Quota {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sourceQuotaId  String?
  name           String
  shortName      String?
  masterQuota    String?
  normalizedCode String?
  ownership      SeatOwnership?

  counsellingId String?      @db.ObjectId
  counselling   Counselling? @relation(fields: [counsellingId], references: [id])

  allotments AllotmentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceQuotaId, counsellingId])
  @@index([name])
  @@index([shortName])
  @@index([masterQuota])
  @@index([normalizedCode])
  @@index([ownership])
  @@index([counsellingId])
}

model CategoryMap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Example rawName values from your files: Open, UR-OP, OP, GM, GMP, CAT B-GEN, SCG, MBC, EWS, CAT C(NRI)
  rawName         String
  displayName     String
  normalizedGroup String

  isPwd        Boolean @default(false)
  isFemale     Boolean @default(false)
  isNri        Boolean @default(false)
  isMinority   Boolean @default(false)
  isManagement Boolean @default(false)
  isDefence    Boolean @default(false)
  isEws        Boolean @default(false)

  counsellingId String?      @db.ObjectId
  counselling   Counselling? @relation(fields: [counsellingId], references: [id])

  allotments AllotmentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rawName, counsellingId])
  @@index([rawName])
  @@index([displayName])
  @@index([normalizedGroup])
  @@index([counsellingId])
}

model AllotmentRecord {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Generate this in import script to stop duplicate imports.
  // Example: `${session}_${counselling_id}_${round_no}_${zynerd_allotment_id}`
  sourceKey String @unique

  // Raw source IDs from CSV are strings because some future sources may not be numeric.
  zynerdAllotmentId   String?
  sourceCounsellingId String?
  sourceInstituteId   String?
  sourceCourseId      String?
  sourceQuotaId       String?
  sourceFeeId         String?

  // Year/session and counselling
  sessionYear      Int
  counsellingLevel CounsellingLevel

  counsellingId String?      @db.ObjectId
  counselling   Counselling? @relation(fields: [counsellingId], references: [id])

  sourceStateName       String?
  sourceCounsellingName String?
  counsellingName       String?

  // Round and rank: keep raw + parsed
  roundRaw String?
  roundNo  Float?

  rankRaw String?
  rank    Int?

  aiRankRaw          String?
  aiRank             Int?
  counsellingRankRaw String?
  counsellingRank    Int?

  // Institute reference + fast display snapshot
  instituteId String?    @db.ObjectId
  institute   Institute? @relation(fields: [instituteId], references: [id])

  instituteNameSnapshot      String?
  instituteShortNameSnapshot String?
  instituteDistrictSnapshot  String?
  instituteStateSnapshot     String?
  instituteStateSlugSnapshot String?

  // Course reference + snapshot
  courseId String? @db.ObjectId
  course   Course? @relation(fields: [courseId], references: [id])

  courseNameSnapshot      String
  courseShortNameSnapshot String?
  courseTypeSnapshot      CourseType?

  // Quota reference + snapshot
  quotaIdRef String? @db.ObjectId
  quota      Quota?  @relation(fields: [quotaIdRef], references: [id])

  quotaNameSnapshot       String?
  quotaShortNameSnapshot  String?
  masterQuotaSnapshot     String?
  quotaNormalizedSnapshot String?
  ownershipSnapshot       SeatOwnership?

  // Category reference + normalized values
  categoryMapId String?      @db.ObjectId
  categoryMap   CategoryMap? @relation(fields: [categoryMapId], references: [id])

  categoryRaw        String?
  categoryDisplay    String?
  categoryNormalized String?

  isPwd        Boolean @default(false)
  isFemale     Boolean @default(false)
  isNri        Boolean @default(false)
  isMinority   Boolean @default(false)
  isManagement Boolean @default(false)

  predictionResults PredictionResult[]

  // Fee/college decision fields: raw + parsed numeric for filters
  feeRaw    String?
  feeAmount Int?

  bedsRaw   String?
  bedsCount Int?

  bondYearsRaw    String?
  bondYearsNumber Float?

  bondPenaltyRaw    String?
  bondPenaltyAmount Int?

  stipendYear1Raw    String?
  stipendYear1Amount Int?

  inserviceCandidate Boolean @default(false)
  candidateFlag      String?
  choiceListCount    Int?

  importBatchId String? @db.ObjectId

  // Store the complete original CSV row for future debugging.
  rawRow Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Single-field indexes
  @@index([sessionYear])
  @@index([counsellingLevel])
  @@index([roundNo])
  @@index([rank])
  @@index([aiRank])
  @@index([counsellingRank])
  @@index([courseNameSnapshot])
  @@index([courseTypeSnapshot])
  @@index([categoryNormalized])
  @@index([categoryRaw])
  @@index([masterQuotaSnapshot])
  @@index([quotaNameSnapshot])
  @@index([quotaNormalizedSnapshot])
  @@index([ownershipSnapshot])
  @@index([feeAmount])
  @@index([bondYearsNumber])
  @@index([bedsCount])
  @@index([instituteStateSlugSnapshot])
  // Predictor query indexes
  @@index([sessionYear, counsellingLevel, courseNameSnapshot, categoryNormalized, roundNo, rank])
  @@index([sessionYear, counsellingLevel, courseNameSnapshot, rank])
  @@index([sessionYear, counsellingLevel, masterQuotaSnapshot, courseNameSnapshot, categoryNormalized, rank])
  @@index([sessionYear, counsellingId, courseNameSnapshot, categoryNormalized, rank])
  @@index([sessionYear, counsellingId, roundNo])
  // Relation indexes
  @@index([counsellingId])
  @@index([instituteId])
  @@index([courseId])
  @@index([quotaIdRef])
  @@index([categoryMapId])
  @@index([importBatchId])
}

model PredictionQuery {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  sessionYear      Int
  counsellingLevel CounsellingLevel

  counsellingId String? @db.ObjectId

  inputRank Int

  courseName         String?
  categoryRaw        String?
  categoryNormalized String?

  statePreference String?
  masterQuota     String?
  quotaName       String?
  roundNo         Float?

  feeMax       Int?
  bondYearsMax Float?

  filters Json?

  results PredictionResult[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionYear])
  @@index([counsellingLevel])
  @@index([counsellingId])
  @@index([inputRank])
}

model PredictionResult {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  predictionQueryId String          @db.ObjectId
  predictionQuery   PredictionQuery @relation(fields: [predictionQueryId], references: [id])

  allotmentRecordId String?          @db.ObjectId
  allotmentRecord   AllotmentRecord? @relation(fields: [allotmentRecordId], references: [id])

  chance PredictionChance

  userRank       Int
  previousRank   Int?
  rankDifference Int?
  rankRatio      Float?

  explanation String?

  instituteName String
  courseName    String
  stateName     String?
  quotaName     String?
  masterQuota   String?
  category      String?
  roundNo       Float?
  feeRaw        String?
  bondYearsRaw  String?

  createdAt DateTime @default(now())

  @@index([predictionQueryId])
  @@index([allotmentRecordId])
  @@index([chance])
  @@index([previousRank])
}

model FcmToken {
  id         String   @id @default(uuid()) @map("_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  token      String   @unique
  deviceType String?  @map("device_type")
  deviceName String?  @map("device_name")
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
