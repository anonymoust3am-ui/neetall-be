generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid()) @map("_id")
  firebaseUid String   @unique @map("firebase_uid")
  phone     String   @unique
  phoneVerified Boolean @default(true) @map("phone_verified")
  email     String?   @unique
  emailVerified Boolean @default(false) @map("email_verified")
  isEmailCodeSent Boolean @default(false) @map("is_email_code_sent")
  name      String?
  updatedAt DateTime @updatedAt
  alternatePhone String? @unique
  country  String? @default("IN")
  state  String?
  city  String?
  dob String?
  PrefExam String?
  profilePic String?
  Role String? @default("student")
  RefSource String? @default("google")
  Rank Int? @default(0)
  Score Int? @default(0)
  Category String? @default("general")
  Gender String? @default("N/A")
  isProfileComplete Boolean @default(false)
  refralCode String? @unique
  Theme String? @default("light")
  refredUsers RefredUser[]
  Sessions Session[]
  userPackages UserPackage[]
  Testimonial Testimonial?
  createdAt DateTime @default(now())
}

model RefredUser {
  id String @id @default(uuid()) @map("_id")
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(uuid()) @map("_id")
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  DeviceId String? @unique @map("device_id")
  DeviceType String? @map("device_type")
  deviceName String? @map("device_name")
  IpAddress String? @map("ip_address")
  LastSeen DateTime? @map("last_seen")
  IsActive Boolean? @map("is_active")
  createdAt DateTime @default(now())
}


model Testimonial {
  id          String   @id @default(uuid()) @map("_id")
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique  // 🔒 ensures ONE testimonial per user
  title       String?
  content     String?  // written review
  rating      Int?     // optional (1–5)
  media       TestimonialMedia[]
  isApproved  Boolean  @default(false) // moderation
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestimonialMedia {
  id             String   @id @default(uuid()) @map("_id")
  testimonial    Testimonial @relation(fields: [testimonialId], references: [id])
  testimonialId  String
  type           MediaType
  url            String
  thumbnailUrl   String?   // useful for videos
  createdAt      DateTime @default(now())
}

enum MediaType {
  VIDEO
  IMAGE
}


model Package {
  id            String      @id @default(uuid()) @map("_id")
  name          String      // e.g. "NEET PG 2025"
  tier          Tier        // PRO | STANDARD
  price         Int         // in INR (₹4499 → 4499)
  currency      String      @default("INR")
  validTill     DateTime
  availability  Availability

  coverage      Coverage    @relation(fields: [coverageId], references: [id])
  coverageId    String

  features      PackageFeature[]
  tools         PackageTool[]
  insights      PackageInsight[]
  explores      PackageExplore[]
  CouponCode     String?     @map("coupon_code")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userPackages UserPackage[]
}

model UserPackage {
  id        String   @id @default(uuid()) @map("_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String   @map("package_id")
  createdAt DateTime @default(now())
}

model Coupon {
  id          String   @id @default(uuid()) @map("_id")
  code        String   @unique
  description String?
  discount    Int      // in percentage (20% → 20)
  validTill   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coverage {
  id          String   @id @default(uuid()) @map("_id")
  type        CoverageType // ALL_INDIA | ALL_INDIA_AND_STATES
  description String?      // "All India & 40+ State Counsellings"
  packages    Package[]
}

model Feature {
  id        String         @id @default(uuid()) @map("_id")
  name      String
  packages  PackageFeature[]
}

model Tool {
  id        String         @id @default(uuid()) @map("_id")
  name      String
  packages  PackageTool[]
}

model Insight {
  id        String         @id @default(uuid()) @map("_id")
  name      String
  packages  PackageInsight[]
}

model Explore {
  id        String         @id @default(uuid()) @map("_id")
  name      String
  packages  PackageExplore[]
}

model PackageFeature {
  id        String   @id @default(uuid()) @map("_id")
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String   @map("package_id")
  feature   Feature  @relation(fields: [featureId], references: [id])
  featureId String   @map("feature_id")
}

model PackageTool {
  id        String   @id @default(uuid()) @map("_id")
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String   @map("package_id")
  tool      Tool     @relation(fields: [toolId], references: [id])
  toolId    String   @map("tool_id")
}

model PackageInsight {
  id         String   @id @default(uuid()) @map("_id")
  package    Package  @relation(fields: [packageId], references: [id])
  packageId  String   @map("package_id")
  insight    Insight  @relation(fields: [insightId], references: [id])
  insightId  String   @map("insight_id")
}

model PackageExplore {
  id         String   @id @default(uuid()) @map("_id")
  package    Package  @relation(fields: [packageId], references: [id])
  packageId  String   @map("package_id")
  explore    Explore  @relation(fields: [exploreId], references: [id])
  exploreId  String   @map("explore_id")
}

enum Tier {
  PRO
  STANDARD
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
}

enum CoverageType {
  ALL_INDIA
  ALL_INDIA_AND_STATES
}


model Blogs {
  id        String   @id @default(uuid()) @map("_id")
  title     String
  description String?
  content   String?
  author    Author   @relation(fields: [authorId], references: [id])
  authorId  String   @map("author_id")
  slug      String?  @unique
  imageUrl  String?
  coverImageUrl String?
  tags      String[] // e.g. ["NEET", "Exam Tips", "Study Plan"]
  faqs      FAQ[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid()) @map("_id")
  question  String
  answer    String
  blog      Blogs    @relation(fields: [blogId], references: [id])
  blogId    String   @map("blog_id")
}


model Author {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  tag       String?
  bio       String?
  avatarUrl String?
  expertise String?
  Blogs     Blogs[]
  socialLinks SocialLink[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid()) @map("_id")
  platform  String @default("linkedin") // e.g. "linkedin", "twitter", "facebook", youtube", "instagram"
  url       String
  author    Author   @relation(fields: [authorId], references: [id])
  authorId  String   @map("author_id")
}
